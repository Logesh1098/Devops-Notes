# To Install the docker 
--------------------------
sudo yum install docker -y

# Then we have start docker 
-------------------------------
systemctl start docker 

# to see the docker version 
-------------------------------
docker -y

#to see the docker images 
-------------------------------
docker images

#To see the docker container which are in running stage 
---------------------------------------------------------
docker ps 

# To see running containers and stopped containers 
-----------------------------------------------------
docker ps -a 

# To pull the image from docker to EC2 iinstance
---------------------------------------------------
docker pull <imagename>

#Also we can check in EC2 instance using the command 
-------------------------------------------------------
docker search <imagename>
===================================================================================================================================

#To create the container inside the docker
---------------------------------------------

#Method 1
-----------
docker run -it --name <containername> <Imagename or ImageID>
(-it represent the Interative Mode )

#Method 2
----------
docker run -it -d --name <containername> <Imagename or imageID >
(-d dtached mode , it will not go inside the contained, just to create the container )  

#To go inside the container 
-------------------------------------
Method 1 : 
----------
docker exec -it <containername> /bin/bash (preferred method)

Method 2 :
----------
docker attach <containername>

#To come out of the container 
----------------------------------------
1. ctrl+p+q  (To come of the coonntainer in the safe mode )
2. ctrl+d (It will kill the things inside the container , it is notrecommended )

# To Stop the Container 
------------------------------
docker stop <ContainerName or Container ID >

#To Start the Conainer 
-------------------------------
docker start <containerNAme or ContainerID>

#To  KILL the Container (if you think that you dont want the container you can use the Kill )
------------------------------------------------------------------------------------------------
docker kill <containername or containerid >

#To restart the Kiled Container 
------------------------------------
docker ps -a 
(you will the killed container in Exited State copy the container id and agai you can restart the container)
docker start <containerid>

# To restart the Container 
------------------------------
docker restsart <containername>

# To Pause the container 
------------------------------
docker pause <containername>

# To unpause the Container 
-------------------------------
docker unpause <containername>

#To Get the detailed information of the container 
--------------------------------------------------
docker inspect <coontainername >

#To remove the container
------------------------------
docker rm <containername>
docker rm -f <containername>  (forcefully remove the container even the coontainer is running )
************(once you remove the container you can again retrive the container )*******************

# To remove the image 
--------------------------
docker rmi <imagename or image id >

# To see the logs of the contaiiner 
-----------------------------------------
docker logs <containername>

# To see how much CPU or Memory utilized by container 
---------------------------------------------------------
docker stats

#To create the custom image 
-------------------------------------------
docker commit <containername > <your new image name >

==============================================================================================================

# Commands to copy the file from EC2 instance to the container 
---------------------------------------------------------------
docker cp <filename> <containername >
if you want to copy to the specific path then we can give the path in the container 
<container: path >

# To Rename the Container 
---------------------------
docker  rename <containername> <The name you have to Modify>
Note : In case the rename is  not working , Stop the container and then try to rename it.

# To Login into the dockerHub
-------------------------------
docker login -u <yourDockerAccountname>
(onceyou Hit Enter it will ask for the dockerhub password )

# To remove the Unused image and Container 
---------------------------------------------
docker system prune -a 

# The Container is in running state however we have to remove 
-----------------------------------------------------------------
docker ps -aq (it will list all the container id )
docker kill $(docker ps -aq)
docker rm $(docker ps -aq)
# Similary to remove the docker image 
-------------------------------------
docker image -q (it  will list all the images )
docker rmi -f $(docker images -q )
(-f ) ==> forcefully 


